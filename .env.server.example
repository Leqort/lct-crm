# Copy to /opt/lct-crm/.env on the test server and fill in real values.
# IMAGE_NAME and IMAGE_TAG are supplied by GitHub Actions at deploy time.

ENV=test
AUTH_MODE=dev
LOG_LEVEL=INFO

POSTGRES_USER=crm
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=crm
SEED_ON_START=false

# DNS A/AAAA records for both domains must point to this server.
DOMAIN=crm.example.com
KEYCLOAK_DOMAIN=auth.crm.example.com
GRAFANA_DOMAIN=grafana.crm.example.com
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-keycloak-password

# Set these when AUTH_MODE=keycloak.
KEYCLOAK_ISSUER=https://auth.crm.example.com/realms/crm
KEYCLOAK_AUDIENCE=

# Monitoring endpoints are not published by docker-compose.deploy.yml. Access
# them through a private network, VPN, or an authenticated reverse proxy.
PROMETHEUS_RETENTION_TIME=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
