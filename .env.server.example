# Copy to /opt/lct-crm/.env on the test server and fill in real values.
# IMAGE_NAME and IMAGE_TAG are supplied by GitHub Actions at deploy time.

ENV=test
AUTH_MODE=dev
LOG_LEVEL=INFO

POSTGRES_USER=crm
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=crm
SEED_ON_START=false

API_PORT=8000
KEYCLOAK_PORT=8080
KEYCLOAK_HOSTNAME=YOUR_SERVER_IP_OR_DNS
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-keycloak-password

# Set these when AUTH_MODE=keycloak.
KEYCLOAK_ISSUER=http://YOUR_SERVER_IP_OR_DNS:8080/realms/crm
KEYCLOAK_AUDIENCE=

